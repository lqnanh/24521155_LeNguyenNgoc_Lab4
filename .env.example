# Mẫu biến môi trường của Lab 4 (không chứa bí mật thật).
# Mỗi phần chạy từ thư mục riêng và đọc file .env của chính nó:
#   server/.env  ← chép từ server/.env.example
#   client/.env  ← chép từ client/.env.example
# File .env thật đã nằm trong .gitignore, không commit.

# ===== server/.env =====
# Cổng server Express
PORT=3000
# Địa chỉ client duy nhất được phép gọi API (CORS). Đổi theo cổng Vite đang chạy.
CLIENT_ORIGIN=http://localhost:5173
# Làm chậm API tin nhắn (ms) để thử huỷ request khi đổi kênh. 0 = không chậm.
SIMULATED_DELAY_MS=0

# ===== client/.env =====
# Địa chỉ server, phải trùng PORT ở trên. Biến VITE_ nằm trong code gửi xuống trình duyệt, không để bí mật.
VITE_API_URL=http://localhost:3000
